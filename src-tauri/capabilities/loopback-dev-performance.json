{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "loopback-dev-performance",
  "description": "allows only the trusted main loopback webview to sample debug performance metrics",
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "webviews": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "http://[\\:\\:1]:*/*"
    ]
  },
  "permissions": [
    "allow-dev-performance-snapshot"
  ]
}
